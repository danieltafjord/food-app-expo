# Legend-State v3 (beta) declares a stale `peerOptional expo-sqlite@^15.0.0`,
# which never matches Expo SDK 56's SDK-aligned `expo-sqlite@~56.x`. The peer is
# optional and harmless at runtime, so relax npm's strict peer resolution to keep
# installs working. Revisit when Legend-State v3 bumps its peer range.
legacy-peer-deps=true
