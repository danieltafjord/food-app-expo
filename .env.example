# Backend origin. Locally the Laravel app is served by Herd at http://food-app.test
# (plain HTTP; the iOS simulator resolves .test via Herd's DNS). A physical
# device must use your machine's LAN IP or a tunnel instead.
EXPO_PUBLIC_API_URL=http://food-app.test

# Public Passport client id. Create it once per backend environment:
#   php artisan passport:client --public \
#     --name="Food App Mobile" \
#     --redirect_uri="foodapp://oauth/callback"
# Leave empty to hide the "Connect cloud account" flow.
EXPO_PUBLIC_OAUTH_CLIENT_ID=

# Required for App Store builds. Deploy the backend pages before submitting.
EXPO_PUBLIC_PRIVACY_URL=https://handlelistaapp.no/privacy
EXPO_PUBLIC_SUPPORT_URL=https://handlelistaapp.no/support
