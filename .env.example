# Backend origin. The iOS simulator can reach the host via localhost; a physical
# device must use your machine's LAN IP (e.g. http://192.168.1.20:8000).
EXPO_PUBLIC_API_URL=http://localhost:8000

# Public Passport client id. Create it once per backend environment:
#   php artisan passport:client --public \
#     --name="Food App Mobile" \
#     --redirect_uri="foodapp://oauth/callback"
EXPO_PUBLIC_OAUTH_CLIENT_ID=
